    "@fontsource/jost": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@preact/preset-vite": "^2.9.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
